{
  "name": "wizard-food",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:sync": "pnpm run content:sync:website",
    "content:sync:website": "pnpm --filter website run content:sync",
    "dev": "turbo run dev --filter website --continue",
    "build": "turbo run build",
    "generate": "pnpm --filter website run generate",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run lint && pnpm run format:check",
    "lint": "pnpm run lint:ox",
    "lint:ox": "oxlint -c .oxlintrc.json --import-plugin --vue-plugin .",
    "lint:fix": "pnpm run lint:ox -- --fix",
    "format": "oxfmt -c .oxfmtrc.json --write --no-error-on-unmatched-pattern \"*.{json,md,yaml,yml}\" \"apps/**/*.{js,jsx,mjs,cjs,ts,tsx,vue,json,md,scss,yaml,yml}\" \"packages/**/*.{js,jsx,mjs,cjs,ts,tsx,vue,json,md,scss,yaml,yml}\" \"extensions/**/*.{js,jsx,mjs,cjs,ts,tsx,vue,json,md,scss,yaml,yml}\" \"openapi/**/*.json\"",
    "format:check": "oxfmt -c .oxfmtrc.json --check --no-error-on-unmatched-pattern \"*.{json,md,yaml,yml}\" \"apps/**/*.{js,jsx,mjs,cjs,ts,tsx,vue,json,md,scss,yaml,yml}\" \"packages/**/*.{js,jsx,mjs,cjs,ts,tsx,vue,json,md,scss,yaml,yml}\" \"extensions/**/*.{js,jsx,mjs,cjs,ts,tsx,vue,json,md,scss,yaml,yml}\" \"openapi/**/*.json\""
  },
  "devDependencies": {
    "jiti": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
