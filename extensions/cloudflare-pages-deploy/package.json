{
  "name": "@wizard/cloudflare-pages-deploy",
  "version": "1.0.0",
  "description": "Please enter a description for your extension",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-operation"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "build-remote": "directus-extension build && pnpm run push-remote",
    "push-remote": "pnpm run push-app && pnpm run push-api",
    "push-app": "scp dist/app.js oracle:~/docker-cloud/directus/extensions/cloudflare-pages-deploy/dist/app.js",
    "push-api": "scp dist/api.js oracle:~/docker-cloud/directus/extensions/cloudflare-pages-deploy/dist/api.js",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "cloudflare": "catalog:"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:"
  },
  "icon": "extension",
  "directus:extension": {
    "type": "operation",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "source": {
      "app": "src/app.ts",
      "api": "src/api.ts"
    },
    "host": "^10.10.0"
  }
}
