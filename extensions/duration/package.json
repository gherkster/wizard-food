{
  "name": "@wizard/duration",
  "version": "1.0.0",
  "description": "Please enter a description for your extension",
  "keywords": [
    "directus",
    "directus-custom-interface",
    "directus-extension"
  ],
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "build-remote": "directus-extension build && pnpm run push-remote",
    "push-remote": "scp dist/index.js oracle:~/docker-cloud/directus/extensions/directus-extension-duration/dist/index.js",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "catalog:",
    "typescript": "^5.9.3",
    "vue": "^3.5.30"
  },
  "icon": "extension",
  "directus:extension": {
    "type": "interface",
    "host": "^10.10.0",
    "path": "dist/index.js",
    "source": "src/index.ts"
  }
}
