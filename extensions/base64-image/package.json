{
  "name": "@wizard/base64-image",
  "version": "1.0.0",
  "description": "Please enter a description for your extension",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-hook"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "build-remote": "directus-extension build && pnpm run push-remote",
    "push-remote": "scp dist/index.js oracle:~/docker-cloud/directus/extensions/base64-image/dist/index.js",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "icon": "extension",
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^10.10.0"
  }
}
