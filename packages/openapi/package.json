{
  "name": "@wizard/openapi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "openapi:generate": "openapi-typescript ../../openapi/directus.json -o ./src/types/directus-schema.d.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "catalog:",
    "typescript": "catalog:"
  }
}
