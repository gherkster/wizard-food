{
  "rules": {
    "no-debugger": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNumber": false,
        "allowNullableBoolean": true,
        "allowNullableObject": true,
        "allowNullableString": true,
        "allowString": true
      }
    ]
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/.nuxt/**",
    "**/.output/**",
    "pnpm-lock.yaml"
  ]
}
