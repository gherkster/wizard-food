{
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": {
    "order": "desc",
  },
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/.nuxt/**",
    "**/.output/**",
    "pnpm-lock.yaml",
    "directus-schema.d.ts",
  ],
}
