{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#lint", "test"],
      "outputs": [
        "dist/**",
        ".output/**",
        "apps/website/.output/**",
        "apps/website/.nuxt/**",
        "apps/website/node_modules/.cache/nuxt/.nuxt/**"
      ]
    },
    "generate": {
      "dependsOn": ["^build", "//#lint", "test"],
      "outputs": [
        "dist/**",
        ".output/**",
        "apps/website/.output/**",
        "apps/website/.nuxt/**",
        "apps/website/node_modules/.cache/nuxt/.nuxt/**"
      ],
      "envMode": "loose"
    },
    "test": {
      "cache": false
    },
    "//#lint": {
      "cache": true,
      "inputs": ["**/*.{js,ts,tsx,jsx}", ".oxfmtrc*"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
