{
  "name": "website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "content:sync": "pnpm --filter @wizard/content-pipeline run content:sync sync --site $PWD --content-dir .content",
    "dev": "vite dev --port 3000",
    "search:generate": "tsx ./scripts/generate-search-assets.ts",
    "build": "pnpm run search:generate && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@wizard/content": "workspace:*",
    "lucide-react": "catalog:",
    "minisearch": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/start-static-server-functions": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
