{
  "name": "website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "content:sync": "pnpm --filter @wizard/content-pipeline run content:sync sync --site $PWD --content-dir .content",
    "dev": "vite dev --port 3000",
    "search:generate": "tsx ./scripts/generate-search-assets.ts",
    "build": "pnpm run search:generate && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "catalog:",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-router-ssr-query": "1.166.11",
    "@tanstack/react-start": "1.167.41",
    "@tanstack/router-plugin": "^1.132.0",
    "@wizard/content": "workspace:*",
    "lucide-react": "^0.545.0",
    "minisearch": "catalog:",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "tsx": "catalog:",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
