{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run content:sync && pnpm run search:generate && nuxt dev",
    "generate": "pnpm run content:sync && pnpm run search:generate && nuxt generate",
    "content:sync": "pnpm --filter @wizard/content-pipeline run content:sync sync --site $PWD --dotenv-file .env --content-dir .content",
    "search:generate": "tsx ./scripts/generateSearchAssets.ts",
    "prepare": "nuxt prepare",
    "bundle:analyze": "nuxi analyze",
    "typecheck": "nuxi typecheck",
    "preview": "npx serve .output/public"
  },
  "dependencies": {
    "dayjs": "catalog:",
    "fraction.js": "catalog:",
    "minisearch": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/mynaui": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxt/icon": "catalog:",
    "@nuxtjs/robots": "catalog:",
    "@nuxtjs/sitemap": "catalog:",
    "@types/node": "catalog:",
    "@wizard/content": "workspace:*",
    "nuxt": "catalog:",
    "sass": "catalog:",
    "schema-dts": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
