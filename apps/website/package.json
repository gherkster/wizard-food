{
  "name": "@wizard/website",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "wrangler pages dev .output/public",
    "postinstall": "pnpm --filter @wizard/openapi build && pnpm --filter @wizard/content build && pnpm exec nuxt prepare",
    "pages:dev": "wrangler pages dev --compatibility-date=2025-02-14 -- pnpm run dev",
    "pages:deploy": "pnpm run build && wrangler pages deploy ./dist",
    "bundle:analyze": "nuxi analyze",
    "typecheck": "NUXT_PREPARE_SKIP=1 nuxi typecheck"
  },
  "dependencies": {
    "dayjs": "catalog:",
    "fraction.js": "catalog:",
    "minisearch": "catalog:"
  },
