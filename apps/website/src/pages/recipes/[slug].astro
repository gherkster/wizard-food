---
import { loadRecipesBySlug } from "@wizard/content/store";
import type { RecipePayload } from "@wizard/content/store";

import RecipePage from "@/components/recipes/RecipePage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { recipeTotalDuration } from "@/utils/formatting";

type StaticProps = {
  recipe: RecipePayload;
};

export async function getStaticPaths() {
  const recipesBySlug = await loadRecipesBySlug(".content");

  const recipes = Object.entries(recipesBySlug);

  if (recipes.length === 0) {
    throw new Error("No recipes loaded from content directory.");
  }

  return recipes.map(([slug, recipe]) => ({
    params: { slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props as StaticProps;

const servingsLabel =
  recipe.servings && recipe.servingsType
    ? recipe.servings > 1
      ? recipe.servingsType.plural
      : recipe.servingsType.singular
    : undefined;

const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: recipe.title,
  description: recipe.descriptionSnippet,
  image: recipe.coverImage.variants.cover.square.src,
  recipeCategory: recipe.course,
  recipeCuisine: recipe.cuisine,
  recipeYield:
    recipe.servings && servingsLabel ? `${recipe.servings} ${servingsLabel}` : undefined,
  keywords: recipe.tags.filter((t) => t !== recipe.course && t !== recipe.cuisine).join(", "),
  totalTime: recipeTotalDuration(recipe).toISOString(),
};
---

<BaseLayout
  title={recipe.title}
  description={recipe.descriptionPlainText}
  canonicalPath={`/recipes/${recipe.slug}`}
  ogTitle={recipe.title}
  ogDescription={recipe.descriptionSnippet}
  ogImage={recipe.coverImage.variants.cover.square.src}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />
  </Fragment>
  <RecipePage recipe={recipe} />
</BaseLayout>
