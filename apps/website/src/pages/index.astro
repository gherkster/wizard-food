---
import { loadFeaturedRecipes, loadPagesContent } from "@wizard/content/store";

import HomePage from "@/components/home/HomePage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featuredRecipes = await loadFeaturedRecipes(".content");
const pagesContent = await loadPagesContent(".content");
const content = pagesContent.home;
---

<BaseLayout
	title={content.title}
	description={content.description}
	canonicalPath="/"
	ogTitle={content.title}
	ogDescription={content.openGraphDescription}
>
	<HomePage featuredRecipes={featuredRecipes} />
</BaseLayout>
